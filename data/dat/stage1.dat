model new
model title "3D Slope - Mohr-Coulomb"
model large-strain on
model mechanical
model deterministic on
model precision 6
model random 10000

program log-file "D:/Flac3d/FLAC/exe64/s1.log" truncate
program log on

zone create brick point 0 (0,0,0) point 1 (30.0,0,0) point 2 (0,10.0,0) point 3 (0,0,6.0) size 30 10 6 group "lower"

zone create brick point 0 (0,10.0,0) point 1 (19.0,10.0,0) point 2 (0,11.0,0) point 3 (0,10.0,6.0) size 19 1 6 group "upper"
zone create brick point 0 (0,11.0,0) point 1 (18.0,11.0,0) point 2 (0,12.0,0) point 3 (0,11.0,6.0) size 18 1 6 group "upper"
zone create brick point 0 (0,12.0,0) point 1 (17.0,12.0,0) point 2 (0,13.0,0) point 3 (0,12.0,6.0) size 17 1 6 group "upper"
zone create brick point 0 (0,13.0,0) point 1 (16.0,13.0,0) point 2 (0,14.0,0) point 3 (0,13.0,6.0) size 16 1 6 group "upper"
zone create brick point 0 (0,14.0,0) point 1 (15.0,14.0,0) point 2 (0,15.0,0) point 3 (0,14.0,6.0) size 15 1 6 group "upper"
zone create brick point 0 (0,15.0,0) point 1 (14.0,15.0,0) point 2 (0,16.0,0) point 3 (0,15.0,6.0) size 14 1 6 group "upper"
zone create brick point 0 (0,16.0,0) point 1 (13.0,16.0,0) point 2 (0,17.0,0) point 3 (0,16.0,6.0) size 13 1 6 group "upper"
zone create brick point 0 (0,17.0,0) point 1 (12.0,17.0,0) point 2 (0,18.0,0) point 3 (0,17.0,6.0) size 12 1 6 group "upper"
zone create brick point 0 (0,18.0,0) point 1 (11.0,18.0,0) point 2 (0,19.0,0) point 3 (0,18.0,6.0) size 11 1 6 group "upper"
zone create brick point 0 (0,19.0,0) point 1 (10.0,19.0,0) point 2 (0,20.0,0) point 3 (0,19.0,6.0) size 10 1 6 group "upper"

zone cmodel assign mohr-coulomb
zone property density 2500.0 bulk 100000000.0 shear 60000000.0 cohesion 30000.0 friction 25.0 tension 10000.0

model gravity 0 -9.81 0
zone gridpoint fix velocity-x range position-x 0
zone gridpoint fix velocity-x range position-x 30.0
zone gridpoint fix velocity-y range position-y 0
zone gridpoint fix velocity-z range position-z 0
zone gridpoint fix velocity-z range position-z 6.0

model solve ratio-local 1e-5

fish define export_g
    local L = list
    L = list.append(L, 'xc,yc,zc,ux,uy,uz,state,szz,sxy')
    loop foreach local zz zone.list
        local p = zone.pos(zz)
        local ngp = zone.gp.num(zz)
        local sdx = 0.0
        local sdy = 0.0
        local sdz = 0.0
        loop local j (1, ngp)
            local g = zone.gp(zz, j)
            sdx += gp.disp.x(g)
            sdy += gp.disp.y(g)
            sdz += gp.disp.z(g)
        endloop
        sdx /= ngp
        sdy /= ngp
        sdz /= ngp
        local st = zone.stress(zz)
        local line = string(p->x)
        line += ',' + string(p->y)
        line += ',' + string(p->z)
        line += ',' + string(sdx)
        line += ',' + string(sdy)
        line += ',' + string(sdz)
        line += ',' + string(zone.state(zz))
        line += ',' + string(st->yy)
        line += ',' + string(st->xy)
        L = list.append(L, line)
    endloop
    file.open("D:/Flac3d/FLAC/exe64/slope_gravity.csv", "write", "text")
    file.write(L)
    file.close
    io.out('### CSV EXPORTED')
end
@export_g

model save "D:/Flac3d/FLAC/exe64/slope_gravity"
program log off